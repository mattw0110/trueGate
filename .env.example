# ── Provider selection ────────────────────────────────────────────────────────
# openai (default) | anthropic | ollama | lmstudio | github-copilot | custom
TRUEGATE_PROVIDER=openai

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# Optional: override the base URL (e.g. Azure OpenAI, Groq, Together AI)
# TRUEGATE_UPSTREAM_URL=https://your-azure-endpoint.openai.azure.com/openai/deployments/gpt-4o

# ── Anthropic / Claude ────────────────────────────────────────────────────────
# TRUEGATE_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# ── Ollama (local, no key needed) ─────────────────────────────────────────────
# TRUEGATE_PROVIDER=ollama
# TRUEGATE_UPSTREAM_URL=http://localhost:11434/v1   # default, override if needed

# ── LM Studio (local, no key needed) ─────────────────────────────────────────
# TRUEGATE_PROVIDER=lmstudio
# TRUEGATE_UPSTREAM_URL=http://localhost:1234/v1    # default, override if needed

# ── GitHub Copilot ────────────────────────────────────────────────────────────
# TRUEGATE_PROVIDER=github-copilot
# GITHUB_TOKEN=ghp_...   # your GitHub PAT or OAuth token with copilot scope

# ── Custom OpenAI-compatible endpoint ────────────────────────────────────────
# TRUEGATE_PROVIDER=custom
# TRUEGATE_UPSTREAM_URL=https://api.groq.com/openai/v1
# TRUEGATE_API_KEY=gsk_...

# ── Server ────────────────────────────────────────────────────────────────────
TRUEGATE_PORT=3457
TRUEGATE_LOG_LEVEL=info
TRUEGATE_PROJECT_ROOT=
